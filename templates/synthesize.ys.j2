# Auto-generated by run_synthesis.py
# Design: {{ design_name }}
# Generated: {{ timestamp }}

# Read Liberty file
read_liberty -ignore_miss_func {{ liberty_file }}

# Read RTL files
{% for f in rtl_files %}
read_verilog {{ f }}
{% endfor %}

# Elaborate
hierarchy -check -top {{ top_module }}

# Generic synthesis
synth -top {{ top_module }}

# Flatten hierarchy before mapping (required for P&R)
flatten

# Map to standard cells
dfflibmap -liberty {{ liberty_file }}
{% if synth_effort == 'high' %}
abc -liberty {{ liberty_file }} -D {{ (clock_period_ns * 1000) | int }}
{% else %}
abc -liberty {{ liberty_file }}
{% endif %}

# Clean up
clean

# Write gate-level netlist
write_verilog {{ output_netlist }}

# Print statistics
stat -liberty {{ liberty_file }}
